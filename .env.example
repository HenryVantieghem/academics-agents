# Root of your school's Canvas. Example: https://school.instructure.com
CANVAS_BASE_URL=

# Canvas -> Account -> Settings -> Approved Integrations -> + New Access Token
# Canvas shows this once. Treat it like a password; .env is gitignored.
CANVAS_TOKEN=

# Optional. IANA zone used to display deadlines. Auto-detected from Canvas when blank.
# CANVAS_TIMEZONE=America/Chicago

# Optional. Defaults to "auto", resolved via /users/self.
# STUDENT_USER_ID=auto
